def multimodal_inference(segment):
    # Step 1: CLIP+BART fusion summary
    clip_embeds = load_precomputed(segment.lecture_id, segment.frame_indices)
    summary = fusion_model.generate(segment.text, clip_embeds)

    # Step 2: LLaVA captions for visual frames (enhancement)
    captions = []
    for frame_path, category in zip(segment.image_paths, segment.categories):
        caption = llava_model.caption(frame_path, prompt=PROMPTS[category])
        captions.append({"path": frame_path, "category": category, "caption": caption})

    return {"summary": summary, "visual_captions": captions}
```

